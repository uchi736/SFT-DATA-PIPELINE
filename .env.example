# ============================================================
# LLMプロバイダ設定（cpt-data-pipeline/llm_factory.py 互換）
# ============================================================
# vllm: vLLM の OpenAI 互換 API（本パイプラインの既定）
# azure: Azure OpenAI（切替時に下のAZURE_*を設定）
LLM_PROVIDER=vllm

# --- vLLM (ローカル) ---
VLLM_ENDPOINT=http://localhost:8000/v1
VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct
VLLM_API_KEY=EMPTY
VLLM_TIMEOUT=300

# --- Azure OpenAI（LLM_PROVIDER=azure のとき使用）---
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_API_VERSION=2024-12-01-preview
# AZURE_OPENAI_CHAT_DEPLOYMENT_NAME=gpt-4.1-mini

# ============================================================
# 長さフィルタ用トークナイザ（学習側=Swallow と一致させる）
# ============================================================
SWALLOW_TOKENIZER=tokyotech-llm/Llama-3.1-Swallow-8B-Instruct-v0.5
# オフライン実行する場合（事前にキャッシュ済み）:
# HF_HUB_OFFLINE=1
# TRANSFORMERS_OFFLINE=1
